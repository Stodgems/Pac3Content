"VertexLitGeneric"
{
	$basetexture "models/shtazi/off_pretor/black"
	$bumpmap "models/shtazi/off_pretor/normal"

	$color2 "[ 0.7 0.7 0.7]"

	$phong 1
   	$phongfresnelranges "[0.5 0.4 0]"
	$phongboost	"1"


	$rimlight 1
	$rimlightexponent       2
	$rimlightboost          .2
	$rimmask 0

	$envmap "env_cubemap"
	$envmaptint "[0.1 0.1 0.1]"
	$envmapfresnel 1
	$blendTintByBaseAlpha 1
	$normalmapalphaenvmapmask 1

	$nocull 1
}